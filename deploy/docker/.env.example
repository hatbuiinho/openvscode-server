COMPOSE_PROJECT_NAME=openvscode-codex
OPENVSCODE_IMAGE=docker.io/YOUR_DOCKERHUB_USERNAME/openvscode-codex:latest
OPENVSCODE_CONTAINER_NAME=openvscode-codex
NGINX_NETWORK=nginx_network

OPENVSCODE_HOME_PATH=./data/home
OPENVSCODE_WORKSPACE_PATH=./data/workspace
OPENVSCODE_TOKEN_FILE=./secrets/connection-token
